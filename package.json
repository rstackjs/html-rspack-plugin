{
  "name": "html-rspack-plugin",
  "version": "6.1.9",
  "license": "MIT",
  "description": "Simplifies creation of HTML files to serve your Rspack bundles",
  "author": "Jan Nicklas <j.nicklas@me.com> (https://github.com/jantimon)",
  "main": "lib/index.js",
  "types": "typings.d.ts",
  "files": [
    "lib/",
    "typings.d.ts"
  ],
  "scripts": {
    "build-examples": "node examples/build-examples.mjs",
    "bump": "pnpx bumpp",
    "check": "rs check",
    "commit": "git-cz",
    "format": "rs fmt",
    "lint": "rs lint",
    "posttest": "tsc",
    "prepare": "rs hooks",
    "test": "rs test run",
    "test:watch": "rs test --watch"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@rspack/lite-tapable": "^1.1.5"
  },
  "devDependencies": {
    "@rspack/core": "^1.7.12",
    "@types/node": "^24.13.3",
    "pug": "3.0.4",
    "pug-loader": "2.4.0",
    "rstack": "^0.7.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    }
  },
  "keywords": [
    "rspack",
    "plugin",
    "html",
    "html-rspack-plugin"
  ],
  "bugs": "https://github.com/rstackjs/html-rspack-plugin/issues",
  "homepage": "https://github.com/rstackjs/html-rspack-plugin",
  "repository": "https://github.com/rstackjs/html-rspack-plugin.git",
  "engines": {
    "node": ">=16.20.2"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/html-webpack-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
